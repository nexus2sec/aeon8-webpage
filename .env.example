# Aeon8Web Environment Variables
# Copy this file to .env.local and fill in your values

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=contact@aeon8systems.in
NEXT_PUBLIC_PILOT_EMAIL=pilot@aeon8systems.in
NEXT_PUBLIC_ACADEMY_EMAIL=academy@aeon8systems.in

# GitHub Configuration
NEXT_PUBLIC_GITHUB_REPO=https://github.com/try2hk/Aeon8_Sentinel
NEXT_PUBLIC_GITHUB_ORG=try2hk

# Site Configuration
NEXT_PUBLIC_SITE_NAME=Aeon8 Systems
NEXT_PUBLIC_SITE_DESCRIPTION=Sovereign Cybersecurity & Kernel Engineering
NEXT_PUBLIC_SITE_URL=https://aeon8systems.in

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CONTACTS_FORM=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Deployment
NODE_ENV=development
